
[Unit]
Description=Stat Lab Django Application
After=network.target

[Service]
EnvironmentFile=/etc/stat-lab/environment
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/stat-lab
Environment="PATH=/home/ubuntu/stat-lab/.venv/bin"
ExecStart=/home/ubuntu/stat-lab/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 statlab.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target